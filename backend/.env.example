# Skopiuj do .env i uzupełnij. Plik .env nie trafia do repozytorium ani do obrazu Docker.

# --- Pliki
MAX_FILE_SIZE_MB=10
MAX_UNCOMPRESSED_MB=100
MAX_PDF_PAGES=30

# --- Uwierzytelnianie JWT (HS256). Wygeneruj np.: python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_ENABLED=true
JWT_SECRET=
JWT_ALGORITHMS=["HS256"]
# JWT_PUBLIC_KEY=          # zamiast JWT_SECRET dla RS256/ES256 (wtedy JWT_ALGORITHMS=["RS256"])
# JWT_AUDIENCE=
# JWT_ISSUER=

# --- Eden AI (model językowy + OCR). Bez klucza: analiza regułami + lokalny Tesseract.
EDENAI_API_KEY=
LLM_MODEL=mistral/mistral-large-4-0@eu
OCR_MODEL=ocr/ocr/mistral
OCR_LANGUAGE=pl
LLM_FALLBACK_MODELS=["mistral/mistral-medium-3.5@eu"]
AI_TIMEOUT_S=300

# --- Generowanie
FINISH_COMPONENT=TEXT_BLOCK
VALIDATION_MODE=filled

# --- Frontend (CORS), np. ["http://localhost:3000"]
CORS_ORIGINS=[]
